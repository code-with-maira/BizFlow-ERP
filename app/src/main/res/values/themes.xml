<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bizzfloww" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryDark">@color/primary_navy_dark</item>
        <item name="colorAccent">@color/accent_blue</item>

        <!-- Custom Field Typography & Contrast -->
        <item name="textInputStyle">@style/Widget.BizFlow.TextInputLayout</item>
    </style>

    <style name="Theme.Bizzfloww" parent="Base.Theme.Bizzfloww" />

    <!-- High-Contrast ERP Input Field Style -->
    <style name="Widget.BizFlow.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_navy</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/accent_blue</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="startIconTint">@color/primary_navy</item>
        <item name="endIconTint">@color/primary_navy</item>
    </style>
</resources>