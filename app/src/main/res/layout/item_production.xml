<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_production"
            android:background="@drawable/bg_icon_circle_purple"
            android:padding="8dp"
            android:contentDescription="Production Log Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_prod_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aluminum Housing Batch #4"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_prod_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date: 2025-02-23"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_prod_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+500 Produced"
                android:textColor="@color/emerald_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_wastage_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-5 Wastage"
                android:textColor="@color/rose_danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>