<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@color/bg_light">

    <ImageView
        android:id="@+id/iv_generic_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_sales"
        android:background="@drawable/bg_icon_circle_blue"
        android:padding="16dp"
        android:contentDescription="Fragment Icon" />

    <TextView
        android:id="@+id/tv_generic_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sales Management"
        android:textColor="@color/primary_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_generic_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BizFlow Enterprise Module is Active"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

</LinearLayout>